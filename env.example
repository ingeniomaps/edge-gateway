# Environment variables for Docker Compose
# Copy this file to .env and adjust values as needed

# Timezone
TZ=UTC

# DNS List Configuration
# Puedes definir una o más listas; cada una puede usar un template distinto.
#
# - DNS_LIST=...           Lista por defecto → template DNS_TEMPLATE o dns-backend.tmpl
# - DNS_LIST_<key>=...     Lista con nombre "key" (ej: api, web)
# - DNS_TEMPLATE=...       Template por defecto (si se usa DNS_LIST sin DNS_TEMPLATE_<key>)
# - DNS_TEMPLATE_<key>=... Template para DNS_LIST_<key> (opcional; si no, dns-backend.tmpl)
#
# IMPORTANT: Tras cambiar DNS_LIST o DNS_LIST_*, reinicia: docker compose restart haproxy
#
# Ejemplo con una sola lista (comportamiento clásico):
#   DNS_LIST=example.com,www.example.com
#
# Ejemplo con una lista por template:
#   DNS_LIST=www.example.com,app.example.com
#   DNS_LIST_api=api.example.com
#   DNS_TEMPLATE_api=dns-backend-api.tmpl
#   DNS_LIST_grpc=grpc.example.com
#   DNS_TEMPLATE_grpc=dns-backend-grpc.tmpl
#   DNS_LIST_ws=ws.example.com
#   DNS_TEMPLATE_ws=dns-backend-websocket.tmpl
#   DNS_LIST_stream=stream.example.com
#   DNS_TEMPLATE_stream=dns-backend-streaming.tmpl
#   DNS_LIST_ai=ai.example.com
#   DNS_TEMPLATE_ai=dns-backend-long-response.tmpl
#
DNS_LIST_api=example.com
DNS_TEMPLATE_api=dns-backend-api.tmpl

# SSL: letsencrypt | mkcert | selfsigned (vacío = selfsigned)
# Se genera un certificado por cada dominio base (cada uno cubre el dominio y *.dominio).
# Dominios base = únicos a partir de DNS_LIST y DNS_LIST_* (ej. ejemplo.com).
# Salida: certs/haproxy-certs/<base>.pem (HAProxy usa SNI con el directorio).
# - letsencrypt: make setup-ssl / make generate-cert / make renew-cert (certbot, dominio público)
# - mkcert: make setup-ssl (desarrollo local; cada base → base + *.\base)
# - selfsigned o vacío: el entrypoint genera uno al iniciar si no hay certs
SSL_CERT_TYPE=mkcert

# Para Let's Encrypt (obligatorio si SSL_CERT_TYPE=letsencrypt)
# CERTBOT_EMAIL=admin@example.com
# CERTBOT_DOMAIN=example.com

# Dominio principal (alternativa a primer DNS_LIST o CERTBOT_DOMAIN)
# SITE_URL=https://example.com

# HAProxy Configuration
# HAPROXY_STATS_USER=admin
# HAPROXY_STATS_PASSWORD=changeme

# Network Configuration
# HAPROXY_NETWORK_SUBNET=172.28.0.0/16

# Logging
# LOG_LEVEL=info
# LOG_DRIVER=json-file
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=3

# INFISICAL
INFISICAL_URL=https://infisical.dev
INFISICAL_TOKEN_1=
